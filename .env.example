# ==============================================
# AI SALES AGENT — Environment Variables
# ==============================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to GitHub — only .env.example

# ------ LLM (Groq) ------
GROQ_API_KEY=your_groq_api_key_here

# ------ Twilio Voice (optional — only needed for phone call channel) ------
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx
MY_PHONE_NUMBER=+91xxxxxxxxxx

# ------ ngrok (only needed for voice_agent.py) ------
PUBLIC_BASE_URL=https://your-ngrok-url.ngrok-free.app

# ------ Gmail (for sending summary emails) ------
GMAIL_ADDRESS=your_gmail@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ------ Telegram Bot ------
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather

# ------ Database (optional — defaults to sales.db in project root) ------
# On Railway: set this to /data/sales.db after mounting a volume
# DB_PATH=/data/sales.db
